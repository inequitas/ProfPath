# Packaging rules for the BigWigs packager (GitHub Actions release). Mirrors tools/package.ps1:
# the zip holds the addon only.
package-as: ProfPath

ignore:
  - tools
  - tests
  - PLAN.md
  - CURSEFORGE.md
  - README.md
  - CONTRIBUTING.md
  - CODE_OF_CONDUCT.md
  - SECURITY.md
  - Media/icon-256.png
  - Media/icon-512.png
